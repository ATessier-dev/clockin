# Neon (PostgreSQL) connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/clockin?sslmode=require
# Use the *pooled* connection string (hostname ends in "-pooler") — the app
# connects via @prisma/adapter-neon (lib/withPrisma.ts), and this same var is
# also what `prisma db push`/`migrate`/`introspect` use for the schema
# engine's own connection (see prisma.config.ts). On Vercel, the Neon
# integration sets this automatically when you link a Neon database to the
# project.
DATABASE_URL=

# JWT signing secret for the clockin_session cookie. Falls back to a fixed
# dev secret outside production (see lib/session-secret.ts) — required in prod.
JWT_SECRET=

# Dev-only override so clock-in can be tested locally without a proxy's
# x-forwarded-for header. Must match a seeded Workplace.allowedCidr to pass.
DEV_CLOCK_IP=
